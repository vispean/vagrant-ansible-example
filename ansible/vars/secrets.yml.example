---
# Vorlage für Geheimnisse. Kopieren nach vars/secrets.yml und eigene Werte setzen.
#   cp vars/secrets.yml.example vars/secrets.yml
# vars/secrets.yml ist in .gitignore und darf NICHT committet werden.
#
# Besser als eine ignorierte Klartextdatei: ansible-vault.
#   ansible-vault encrypt vars/secrets.yml
# (Für den Kursgebrauch reicht die ignorierte Datei; Vault ist der nächste Schritt.)

db_root_password: "CHANGE_ME_root"
wp_db_password:   "CHANGE_ME_wp"
admin_password:   "CHANGE_ME_admin"
samba_password:   "CHANGE_ME_samba"
